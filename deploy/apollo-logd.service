[Unit]
Description=Apollo node-local log recorder
After=local-fs.target
Before=apollo-agent.service

[Service]
Type=simple
User=apollo-logd
Group=apollo-logd
StateDirectory=apollo-logd
StateDirectoryMode=0700
RuntimeDirectory=apollo-logd
RuntimeDirectoryMode=0750
ExecStart=/opt/apollo-logd/bin/apollo-logd --producer-uid 0 --producer-gid 0 --agent-uid 0 --agent-gid 0
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s
UMask=0077
LimitNOFILE=16384
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
MemoryAccounting=yes
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
